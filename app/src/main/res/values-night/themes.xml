<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeshCall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/meshcall_primary</item>
        <item name="colorPrimaryVariant">@color/meshcall_primary_variant</item>
        <item name="colorOnPrimary">@color/meshcall_on_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/meshcall_secondary</item>
        <item name="colorSecondaryVariant">@color/meshcall_secondary_variant</item>
        <item name="colorOnSecondary">@color/meshcall_on_secondary</item>
        
        <!-- System bars (Midnight mode: dark status bar with light icons) -->
        <item name="android:statusBarColor">@color/meshcall_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/meshcall_bg</item>
        
        <!-- Backgrounds & Surfaces -->
        <item name="android:colorBackground">@color/meshcall_bg</item>
        <item name="colorSurface">@color/meshcall_surface</item>
        <item name="colorOnSurface">@color/meshcall_text_primary</item>
        <item name="android:textColorPrimary">@color/meshcall_text_primary</item>
        <item name="android:textColorSecondary">@color/meshcall_text_secondary</item>
        
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>