<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle indigo accent stroke at the bottom -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/meshcall_toolbar_stroke" />
        </shape>
    </item>
    <!-- Dark charcoal/near-black gradient surface, inset 1dp from bottom to reveal stroke -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/meshcall_toolbar_bg_start"
                android:endColor="@color/meshcall_toolbar_bg_end"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
